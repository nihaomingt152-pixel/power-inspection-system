# 环境变量配置
# 复制此文件为 .env 并填入实际值

# DashScope API Key（用于调用 Qwen3-VL-Flash 多模态模型）
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 数据库配置
# 默认使用 SQLite（无需额外配置，适合原型开发）
# 使用 MySQL 时取消下面注释并配置:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=123456
# DB_NAME=power_inspection

# 数据库类型: sqlite（默认） 或 mysql
DB_TYPE=sqlite
DB_PATH=./database/power_inspection.db

# YOLO 模型路径
YOLO_MODEL_PATH=./runs/train/yolo_train_20260729_215517/weights/best.pt

# 服务器配置
HOST=0.0.0.0
PORT=5000

# Session 签名密钥（生产环境请换为随机字符串）
SECRET_KEY=change-me-to-random-string

# 视频分析最大时长（秒），默认处理前 60 秒（逐帧 YOLO + 关键帧 AI）
MAX_VIDEO_SECONDS=60

# 视频抽帧间隔（秒）
VIDEO_FRAME_INTERVAL=5

# 预警置信度阈值
ALERT_CONFIDENCE_THRESHOLD=0.7

# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE=500
